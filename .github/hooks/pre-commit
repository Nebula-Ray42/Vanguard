#!/bin/sh

# 1. フォーマットチェック
echo "Running cargo fmt..."
cargo fmt --all -- --check
if [ $? -ne 0 ]; then
    echo "警告: コードのフォーマットがされていません。"
    echo "'cargo fmt' を実行してから再コミットしてください。"
    exit 1
fi

# 2. 静的解析 (Clippy)
echo "🦀 Running cargo clippy..."
# -D warnings で、警告(Warning)が出た時点でもコミットを弾く厳しい設定
cargo clippy --all-targets --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo "警告: Clippyが問題を検知しました。コードを修正してください。"
    exit 1
fi

echo "すべてのチェックを通過しました！"
exit 0